@@ -0,0 +1,148 @@
+"""对话协调器：按修改波及范围选择执行路径。
+
+三条路径：
+- plan_full：首次规划,或目的地/日期/天数变化导致大部分研究作废;
+- refresh_slice:只有单块研究过期,重跑对应 Worker 后重新编排;
+- rewrite:现有证据范围内调整表述或结构,不查任何新数据。
+"""
+
+from __future__ import annotations
+
+from typing import Literal
+
+from pydantic import BaseModel
+
+from app.agents.planner import create_research_plan
+from app.agents.supervisor import (
+    assemble_draft,
+    build_budget,
+    build_itinerary,
+    run_travel_planning,
+    synthesize_itinerary_with_llm,
+)
+from app.agents.workers import WorkerRegistry, create_default_registry
+from app.config import settings
+from app.schemas.planning import (
+    TaskType,
+    TravelPlanDraft,
+    TravelRequirement,
+    TravelRequirementDraft,
+)
+from app.utils.logger import app_logger
+
+
+RouteAction = Literal["plan_full", "refresh_slice", "rewrite"]
+
+SLICE_KEYWORDS: dict[TaskType, list[str]] = {
+    "transport": ["交通", "高铁", "火车", "机票", "航班", "自驾", "怎么去"],
+    "hotel": ["住宿", "酒店", "民宿", "房型", "住哪"],
+    "food": ["美食", "餐厅", "小吃", "吃什么", "吃的"],
+    "weather": ["天气", "下雨", "气温", "降温"],
+    "destination": ["景点", "攻略", "玩什么", "游览", "去哪玩"],
+}
+
+
+class RouteDecision(BaseModel):
+    action: RouteAction
+    worker: TaskType | None = None
+    reason: str = ""
+
+
+class TripCoordinator:
+    """持有三条执行路径的入口；草稿状态的唯一 owner。"""
+
+    def __init__(self, registry: WorkerRegistry | None = None):
+        self.registry = registry or create_default_registry()
+
+    @staticmethod
+    def route(
+        user_message: str,
+        has_draft: bool,
+        previous: TravelRequirementDraft | None,
+        incoming: TravelRequirementDraft,
+    ) -> RouteDecision:
+        """确定性路由：先看结构性变化,再看话题关键词,默认改写。"""
+        if not has_draft or previous is None:
+            return RouteDecision(action="plan_full", reason="首次规划")
+        if incoming.destination and incoming.destination != previous.destination:
+            return RouteDecision(action="plan_full", reason="目的地变化")
+        if incoming.departure_date and incoming.departure_date != previous.departure_date:
+            return RouteDecision(action="plan_full", reason="出发日期变化")
+        if incoming.days and incoming.days != previous.days:
+            return RouteDecision(action="plan_full", reason="出行天数变化")
+        if incoming.origin and incoming.origin != previous.origin:
+            return RouteDecision(action="refresh_slice", worker="transport", reason="出发地变化")
+        for worker, keywords in SLICE_KEYWORDS.items():
+            if any(keyword in user_message for keyword in keywords):
+                return RouteDecision(action="refresh_slice", worker=worker, reason=f"话题命中 {worker}")
+        return RouteDecision(action="rewrite", reason="证据范围内调整")
+
+    async def plan_full(
+        self,
+        requirement: TravelRequirement,
+        **kwargs,
+    ) -> TravelPlanDraft:
+        return await run_travel_planning(requirement, self.registry, **kwargs)
+
+    async def refresh_slice(
+        self,
+        draft: TravelPlanDraft,
+        worker: TaskType,
+    ) -> TravelPlanDraft:
+        """只重跑一个 Worker,然后重新编排、重算预算、重新综合。"""
+        requirement = draft.requirement
+        task = next(
+            (item for item in create_research_plan(requirement) if item.task_type == worker),
+            None,
+        )
+        if task is None:
+            return draft
+        result = await self.registry.run(task, requirement)
+        results = [result if item.worker == worker else item for item in draft.worker_results]
+        if all(item.worker != worker for item in draft.worker_results):
+            results.append(result)
+        itinerary = build_itinerary(requirement, results)
+        itinerary = await synthesize_itinerary_with_llm(requirement, results, itinerary)
+        return assemble_draft(requirement, results, itinerary, build_budget(requirement))
+
+    async def rewrite(self, draft: TravelPlanDraft, instruction: str) -> TravelPlanDraft:
+        """不查新数据,在现有证据范围内按指令改写行程。"""
+        if not settings.dashscope_api_key:
+            updated = draft.model_copy(deep=True)
+            updated.warnings = list(
+                dict.fromkeys([*updated.warnings, "未配置模型,无法按自然语言指令改写,草稿保持不变。"])
+            )
+            return updated
+        try:
+            from app.agents.llm import get_llm
+            from app.agents.supervisor import _LLMItinerary
+
+            structured = get_llm(temperature=0.3).with_structured_output(_LLMItinerary)
+            response = await structured.ainvoke(
+                [
+                    {
+                        "role": "system",
+                        "content": (
+                            "你是行程编辑，以 JSON 格式输出。按用户指令调整现有行程,"
+                            "只能使用行程中已有的景点、餐厅和事实,不得新增任何未验证信息;"
+                            "保持天数、日期和 morning/afternoon/evening 三时段结构不变。"
+                        ),
+                    },
+                    {
+                        "role": "user",
+                        "content": (
+                            f"现有行程：{[day.model_dump_json() for day in draft.itinerary]}\n"
+                            f"调整指令：{instruction}"
+                        ),
+                    },
+                ]
+            )
+            if len(response.days) != len(draft.itinerary):
+                app_logger.warning("改写返回天数不一致,保持原行程")
+                return draft
+            updated = draft.model_copy(deep=True)
+            updated.itinerary = response.days
+            return updated
+        except Exception as exc:
+            app_logger.warning(f"行程改写失败,保持原行程: {type(exc).__name__}: {exc}")
+            return draft
