+"""阶段二改造:三路径路由、增量刷新、槽位记忆与草稿仓库。"""
+
+from datetime import date
+
+from app.agents.coordinator import TripCoordinator
+from app.agents.supervisor import run_travel_planning
+from app.agents.workers.base import TravelWorker
+from app.agents.workers.registry import WorkerRegistry
+from app.governance.drafts import InMemoryDraftRepository
+from app.schemas.planning import (
+    ResearchTask,
+    TravelRequirement,
+    TravelRequirementDraft,
+    TripDraftRecord,
+    WorkerResult,
+)
+from app.services.planning import merge_drafts
+
+
+class StubWorker(TravelWorker):
+    def __init__(self, summary: str = "ok"):
+        self.summary = summary
+
+    async def run(self, task: ResearchTask, requirement: TravelRequirement) -> WorkerResult:
+        return WorkerResult(
+            task_id=task.id,
+            worker=task.task_type,
+            status="completed",
+            summary=self.summary,
+        )
+
+
+def stub_registry(summary: str = "ok") -> WorkerRegistry:
+    worker = StubWorker(summary)
+    return WorkerRegistry(
+        {key: worker for key in ("destination", "transport", "hotel", "food", "weather")}
+    )
+
+
+def requirement() -> TravelRequirement:
+    return TravelRequirement(
+        origin="上海", destination="成都", departure_date=date(2026, 8, 1), days=3
+    )
+
+
+def previous_draft_fields() -> TravelRequirementDraft:
+    return TravelRequirementDraft(
+        origin="上海", destination="成都", departure_date=date(2026, 8, 1), days=3
+    )
+
+
+def test_route_plans_full_when_no_draft():
+    decision = TripCoordinator.route("随便说点什么", False, None, TravelRequirementDraft())
+    assert decision.action == "plan_full"
+
+
+def test_route_plans_full_on_destination_change():
+    incoming = TravelRequirementDraft(destination="大理")
+    decision = TripCoordinator.route("还是去大理吧", True, previous_draft_fields(), incoming)
+    assert decision.action == "plan_full"
+
+
+def test_route_refreshes_transport_on_origin_change():
+    incoming = TravelRequirementDraft(origin="北京")
+    decision = TripCoordinator.route("我从北京出发", True, previous_draft_fields(), incoming)
+    assert decision.action == "refresh_slice"
+    assert decision.worker == "transport"
+
+
+def test_route_refreshes_slice_on_topic_keyword():
+    decision = TripCoordinator.route(
+        "换个住宿区域看看", True, previous_draft_fields(), TravelRequirementDraft()
+    )
+    assert decision.action == "refresh_slice"
+    assert decision.worker == "hotel"
+
+
+def test_route_defaults_to_rewrite():
+    decision = TripCoordinator.route(
+        "第二天上下午调换一下", True, previous_draft_fields(), TravelRequirementDraft()
+    )
+    assert decision.action == "rewrite"
+
+
+async def test_refresh_slice_only_reruns_target_worker():
+    draft = await run_travel_planning(requirement(), stub_registry("初版"))
+    coordinator = TripCoordinator(stub_registry("更新版"))
+
+    updated = await coordinator.refresh_slice(draft, "hotel")
+
+    summaries = {result.worker: result.summary for result in updated.worker_results}
+    assert summaries["hotel"] == "更新版"
+    assert summaries["transport"] == "初版"
+    assert len(updated.itinerary) == len(draft.itinerary)
+
+
+async def test_rewrite_without_llm_keeps_draft_and_warns(monkeypatch):
+    monkeypatch.setattr("app.agents.coordinator.settings.dashscope_api_key", "")
+    draft = await run_travel_planning(requirement(), stub_registry())
+
+    updated = await TripCoordinator(stub_registry()).rewrite(draft, "改得简洁一点")
+
+    assert [day.model_dump() for day in updated.itinerary] == [
+        day.model_dump() for day in draft.itinerary
+    ]
+    assert any("无法按自然语言指令改写" in warning for warning in updated.warnings)
+
+
+def test_slot_memory_merges_new_values_over_old():
+    previous = previous_draft_fields()
+    incoming = TravelRequirementDraft(days=5)
+
+    merged = merge_drafts(incoming, previous)
+
+    assert merged.days == 5
+    assert merged.destination == "成都"
+    assert merged.origin == "上海"
+
+
+async def test_in_memory_draft_repository_versions_upserts():
+    repository = InMemoryDraftRepository()
+    record = TripDraftRecord(
+        user_id="u1", conversation_id="c1", requirement={}, content={"v": 1}
+    )
+
+    first = await repository.save(record.model_copy(deep=True))
+    second = await repository.save(record.model_copy(deep=True))
+    loaded = await repository.get("u1", "c1")
+
+    assert first.version == 1
+    assert second.version == 2
+    assert loaded.version == 2
+    assert await repository.get("u1", "c2") is None
