+@pytest.mark.skipif(not POSTGRES_TESTS_ENABLED, reason=POSTGRES_SKIP_REASON)
+@pytest.mark.asyncio
+async def test_postgres_rollback_removes_staged_conversation_and_greeting():
+    await init_db()
+    user_id = uuid.uuid4()
+    conversation_id = uuid.uuid4()
+    username = f"task4_rollback_{user_id.hex}"
+    email = f"{username}@example.com"
+
+    try:
+        with pytest.raises(RuntimeError, match="forced Task 4 rollback"):
+            async with async_session_maker() as db:
+                async with db.begin():
+                    db.add(
+                        User(
+                            id=user_id,
+                            username=username,
+                            email=email,
+                            password_hash="task4-integration",
+                            preferences={},
+                        )
+                    )
+                    await db.flush()
+                    db.add(
+                        Conversation(
+                            id=conversation_id,
+                            user_id=user_id,
+                            title="Task 4 rollback",
+                            status="active",
+                        )
+                    )
+                    await db.flush()
+                    db.add(
+                        Message(
+                            conversation_id=conversation_id,
+                            role="assistant",
+                            content="需要我帮你规划一下旅行吗？",
+                            extra_info={"kind": "conversation_offer"},
+                        )
+                    )
+                    await db.flush()
+                    raise RuntimeError("forced Task 4 rollback")
+
+        async with async_session_maker() as db:
+            conversation = await db.scalar(
+                select(Conversation).where(Conversation.id == conversation_id)
+            )
+            message = await db.scalar(
+                select(Message).where(Message.conversation_id == conversation_id)
+            )
+            user = await db.scalar(select(User).where(User.id == user_id))
+
+            assert conversation is None
+            assert message is None
+            assert user is None
+    finally:
+        await cleanup_postgres_user(user_id)
