+            for provider in allowed_providers
+            for name in provider_tool_names.get(provider, set())
+        }
+        if not allowed_names:
+            return []
+        return [
+            tool
+            for tool in await self.get_tools()
+            if getattr(tool, "name", None) in allowed_names
