# ============== LLM 配置 ==============
DASHSCOPE_API_KEY=sk-your-qwen-api-key-here
QWEN_MODEL_NAME=qwen-max
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============== LangSmith 配置 ==============
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=zhixing-travel-planner-dev
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ============== 数据库配置 ==============
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_travel_db
POSTGRES_USER=travel_user
POSTGRES_PASSWORD=travel123456

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============== MCP 服务配置 ==============
AMAP_API_KEY=your-amap-api-key
TAVILY_API_KEY=your-tavily-api-key
VARIFLIGHT_API_KEY=your-variflight-api-key
AIGOHOTEL_MCP_API=your-aigohotel-api-key

# ============== 应用配置 ==============
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
